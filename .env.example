# Firebase Admin SDK service account (Firebase Console → Project settings →
# Service accounts → Generate new private key, project fica-app-fc93c). Set
# these as Vercel environment variables — never commit the real values.
FIREBASE_PROJECT_ID=fica-app-fc93c
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=fica-app-fc93c.firebasestorage.app

# 32 random bytes, base64 — encrypts agents' authenticator (TOTP) secrets and signs
# the short-lived login challenge. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# Super admin access is a Firebase custom claim. Logging in to /superadmin with this
# email (password sign-in) grants it automatically (api/claimSuperAdmin.js); remove this
# variable afterwards to switch that off. Or grant it with: node scripts/grantSuperAdmin.js <email>
SUPER_ADMIN_EMAIL=
