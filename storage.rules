rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSuperAdmin() {
      return request.auth != null && request.auth.token.get('superAdmin', false) == true;
    }

    match /logos/{fileName} {
      allow read: if true; // public branding images
      allow write: if isSuperAdmin() &&
                     request.resource.size < 5 * 1024 * 1024 &&
                     request.resource.contentType.matches('image/.*');
    }

    match /submissions/{companyId}/{submissionId}/{fileName} {
      // Invite clients may only upload into their own submission folder (= invite ID).
      // Sessions are capped at 2 hours from sign-in.
      function isClientUploadFor(cid) {
        return request.auth != null &&
               request.auth.token.role == 'client' &&
               request.auth.token.companyId == cid &&
               request.time < timestamp.value(request.auth.token.auth_time * 1000) + duration.value(2, 'h') &&
               (!('inviteId' in request.auth.token) || request.auth.token.inviteId == submissionId) &&
               request.resource.size < 15 * 1024 * 1024 &&
               request.resource.contentType.matches('image/(jpeg|png|heic|heif|webp)|application/pdf');
      }
      allow create: if isClientUploadFor(companyId);
      // Re-upload (e.g. retrying a failed submit) only within the first hour —
      // after that the document is FICA evidence and is immutable.
      allow update: if isClientUploadFor(companyId) &&
                      request.time < resource.timeCreated + duration.value(1, 'h');
      allow read: if request.auth != null &&
                    (isSuperAdmin() ||
                     (request.auth.token.role == 'agent' &&
                      request.auth.token.companyId == companyId &&
                      request.time < timestamp.value(request.auth.token.auth_time * 1000) + duration.value(12, 'h')));
      // FICA s22–s23: no deletion within 5 years; afterwards super admin only.
      allow delete: if isSuperAdmin() &&
                      request.time > resource.timeCreated + duration.value(1827, 'd');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
