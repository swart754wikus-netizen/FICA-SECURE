rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    match /logos/{fileName} {
      allow read: if true; // public branding images
      allow write: if request.auth != null &&
                     request.auth.token.email == 'swart754wikus@gmail.com' &&
                     request.resource.size < 5 * 1024 * 1024 &&
                     request.resource.contentType.matches('image/.*');
    }

    match /submissions/{companyId}/{submissionId}/{fileName} {
      function isClientUploadFor(cid) {
        return request.auth != null &&
               request.auth.token.role == 'client' &&
               request.auth.token.companyId == cid &&
               request.resource.size < 15 * 1024 * 1024 &&
               request.resource.contentType.matches('image/(jpeg|png|heic|heif|webp)|application/pdf');
      }
      allow create: if isClientUploadFor(companyId);
      // Re-upload (e.g. retrying a failed submit) only within the first hour —
      // after that the document is FICA evidence and is immutable.
      allow update: if isClientUploadFor(companyId) &&
                      request.time < resource.timeCreated + duration.value(1, 'h');
      allow read: if request.auth != null &&
                    (request.auth.token.email == 'swart754wikus@gmail.com' ||
                     (request.auth.token.role == 'agent' &&
                      request.auth.token.companyId == companyId));
      // FICA s22–s23: no deletion within 5 years; afterwards super admin only.
      allow delete: if request.auth != null &&
                      request.auth.token.email == 'swart754wikus@gmail.com' &&
                      request.time > resource.timeCreated + duration.value(1827, 'd');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
